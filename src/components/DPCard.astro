---
import type { CollectionEntry } from 'astro:content';
import { catLabel, catTag, impactLabels, impactTagClass, resolveStatusLabel } from '../lib/dpMaps';

interface Props {
  project: CollectionEntry<'devprojects'>;
}

const { project } = Astro.props;
const p = project.data;
const detailHref = `/dp/${project.slug}/`;
// Embargo (MICRO-O, 2026-11-17): an embargoed DP shows id, title, status and
// target version only. Nothing else is written into the built HTML — the old
// client-side removal left the text in the page source. `astro dev` still
// shows everything, so E.D. can read the full card locally.
const hide = p.embargo && !import.meta.env.DEV;
---

<a
  class={`dp ${p.embargo ? 'embargo-card' : ''}`}
  data-cat={p.cat}
  data-status={p.status}
  data-target={p.targetVersion ?? ''}
  data-stratigraph={!hide && p.stratigraph ? '1' : '0'}
  data-thesis={!hide && p.thesis ? '1' : '0'}
  data-impacts={hide ? '' : (p.impacts || []).join(' ')}
  data-search={(hide
    ? `${p.id} ${p.title} embargo`
    : `${p.id} ${p.title} ${p.desc} ${p.cat} ${(p.impacts || []).join(' ')}${p.stratigraph ? ' stratigraph' : ''}${p.thesis ? ' thesis' : ''}`
  ).toLowerCase()}
  href={detailHref}
>
  <span class="dp-arrow">&rarr;</span>
  <div class="dp-top">
    <span class="dp-id">{p.id}</span>
    <span class="dp-name">{p.title}</span>
  </div>
  <div class="dp-tags">
    {!hide && <span class={`tag ${catTag[p.cat] || ''}`}>{catLabel[p.cat] || p.cat}</span>}
    {p.embargo && <span class="tag tag-embargo">EMBARGO</span>}
    {p.targetVersion && p.targetVersion !== 'TBD' && (
      <span class="tag tag-version">v{p.targetVersion}</span>
    )}
    {!hide && p.thesis && <span class="tag tag-thesis">Thesis</span>}
    {!hide && p.stratigraph && (
      <span
        class="tag tag-stratigraph tag-stratigraph-link"
        data-href="https://stratigraph-eccch.eu"
        data-stop-bubble="1"
        role="link"
        tabindex="0"
      >StratiGraph &#8599;</span>
    )}
    {!hide && (p.impacts || []).map((i) => (
      <span class={`tag ${impactTagClass[i] || ''}`}>{impactLabels[i] || i}</span>
    ))}
  </div>
  {hide ? (
    <div class="dp-desc embargo-note">{resolveStatusLabel(p.status, p.statusLabel)} — details under embargo.</div>
  ) : (
    <div class="dp-desc">{p.desc}</div>
  )}
  <div class="dp-foot">
    {p.targetVersion && <>Target: EM {p.targetVersion}</>}
    {!hide && p.keyStudy && p.keyStudy !== 'Needed' && <> &bull; Key study: {p.keyStudy}</>}
  </div>
</a>
