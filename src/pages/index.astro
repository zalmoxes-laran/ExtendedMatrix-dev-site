---
import Layout from '../layouts/Layout.astro';
import DPFilters from '../components/DPFilters.astro';
import StatusGroup from '../components/StatusGroup.astro';
import { getCollection } from 'astro:content';
import { statusOrder, byDpId } from '../lib/dpMaps';

// Roadmap = all DPs that are still open (neither incorporated nor
// superseded), grouped by status, in the canonical legacy order. Embargoed
// DPs appear as reduced cards (id, title, status, version) — see DPCard.
const all = await getCollection(
  'devprojects',
  ({ data }) => !data.draft && !data.incorporated && data.status !== 'superseded'
);
all.sort(byDpId);

const groups: Record<string, typeof all> = {};
for (const s of statusOrder) groups[s] = [];
for (const p of all) {
  const bucket = groups[p.data.status] || groups['planned'];
  bucket.push(p);
}
---

<Layout activeTab="roadmap">
  <section class="section" id="sec-roadmap">
    <DPFilters />
    <div class="roadmap" id="roadmapContainer">
      {statusOrder.map((s) => <StatusGroup status={s} items={groups[s]} />)}
    </div>
  </section>
</Layout>
